# Quant production runtime for Ubuntu 24.04 behind Nginx
NODE_ENV=production
QUANT_WEB_HOST=127.0.0.1
QUANT_WEB_PORT=47829
QUANT_DATA_DIR=/opt/quant/shared/quant_data

# Safety defaults for first VPS boot
REAL_TRADING=false
MT5_CONNECTOR_ENABLED=false
DEFAULT_PROVIDER=deepseek

# Required backend auth
WEB_AUTH_ENABLED=true
WEB_AUTH_EMAIL=admin@example.com
WEB_AUTH_PASSWORD=change-this-before-start

# Binance
BINANCE_API_KEY=
BINANCE_SECRET=

# AI providers
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_MODEL=Qwen/Qwen2.5-72B-Instruct
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-opus-4-8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Market/news
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Optional MT5 adapter
MT5_ACCOUNT1_LOGIN=
MT5_ACCOUNT1_PASSWORD=
MT5_ACCOUNT1_SERVER=
MT5_ACCOUNT2_LOGIN=
MT5_ACCOUNT2_PASSWORD=
MT5_ACCOUNT2_SERVER=

# Optional sync
QUANT_SYNC_URL=
QUANT_SYNC_KEY=
