          "requireStopLoss": { "type": "boolean" },
          "allowRealTrading": { "type": "boolean" },
          "allowedVenues": {
            "type": "array",
            "items": { "type": "string" }
          },
          "trainingCanChangeCriticalRules": { "type": "boolean", "const": false },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
