          "currency": { "type": "string" },
          "balance": { "type": "number" },
          "equity": { "type": "number" },
          "margin": { "type": "number" },
          "margin_free": { "type": "number" },
          "trade_allowed": { "type": "boolean" },
          "message": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "Mt5ConnectionTestResponse": {
        "type": "object",
