{
  "name": "quant-ai-trading-system",
  "version": "0.2.0",
  "description": "Quant desktop AI trading dashboard",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "web": "electron .",
    "start:backend": "node main.js",
    "test:backend": "node tests/backend_state.test.js && node tests/backend_routes.test.js && node tests/training_static.test.js && node tests/vps_runtime.test.js",
